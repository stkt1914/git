# Public values are embedded in the browser bundle. Never place secrets here.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-only proxy target used by the Next.js backend proxy.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Avoid telemetry configuration writes in restricted Windows environments.
NEXT_TELEMETRY_DISABLED=1

