# Copy this file to .env for local development.
# Never put real credentials in this example file or commit a populated .env file.

APP_NAME=Zhilan Shizheng
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/zhilan.db
NEWS_COLLECTION_INTERVAL_MINUTES=60
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Reserved for a future news source integration. Leave empty locally.
NEWS_API_KEY=

